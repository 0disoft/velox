{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velox.invalid/manifest/v1.json",
  "title": "Velox project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "app"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "singleInstance": { "type": "boolean", "default": false }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 256 },
        "copyright": { "type": "string", "maxLength": 256 }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "default": "web" },
        "entry": { "type": "string", "default": "index.html" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320, "default": 960 },
        "height": { "type": "integer", "minimum": 240, "default": 640 },
        "minWidth": { "type": "integer", "minimum": 0, "maximum": 16384, "default": 0, "description": "Optional outer minimum in 96-DPI logical units; must not exceed initial width. Zero leaves system behavior unchanged." },
        "minHeight": { "type": "integer", "minimum": 0, "maximum": 16384, "default": 0, "description": "Optional outer minimum in 96-DPI logical units; must not exceed initial height. Zero leaves system behavior unchanged." },
        "resizable": { "type": "boolean", "default": true, "description": "Allow user resize and maximization. False restores saved position only, retaining configured DPI-aware size." },
        "alwaysOnTop": { "type": "boolean", "default": false, "description": "Initial topmost state; users can toggle it in the window system menu. Not persisted." },
        "rememberState": { "type": "boolean", "default": false },
        "tray": { "type": "boolean", "default": false }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["app.info", "window.basic", "window.title", "window.attention", "external.open", "file.open", "file.save", "folder.read", "folder.readText", "clipboard.write", "clipboard.read"] },
          "default": []
        }
      }
    }
  }
}
