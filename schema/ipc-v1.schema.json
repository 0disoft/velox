{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velox.invalid/ipc/v1.json",
  "title": "Velox IPC v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": { "const": 1 },
        "id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "allOf": [{
        "if": { "properties": { "method": { "const": "notification.show" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["kind", "message"],
          "properties": {
            "kind": { "enum": ["info", "warning", "error"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 255,
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
              "description": "Non-whitespace text; host enforces 255 UTF-16 units, not code points." }
          }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "window.setProgress" } } },
        "then": { "properties": { "params": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["state"],
              "properties": { "state": { "enum": ["none", "indeterminate"] } } },
            { "type": "object", "additionalProperties": false, "required": ["state", "value"],
              "properties": { "state": { "enum": ["normal", "error", "paused"] },
                "value": { "type": "integer", "minimum": 0, "maximum": 100 } } }
          ]
        } } }
      }, {
        "if": { "properties": { "method": { "const": "window.requestAttention" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false,
          "properties": { "count": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 } }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "window.cancelAttention" } } },
        "then": { "properties": { "params": { "type": "object", "maxProperties": 0 } } }
      }, {
        "if": { "properties": { "method": { "const": "window.setTitle" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["title"],
          "properties": { "title": {
            "type": "string", "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "description": "At most 512 UTF-8 bytes, enforced by the host. Empty resets to the manifest app name."
          } }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "clipboard.writeText" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": { "text": { "type": "string", "maxLength": 32768, "pattern": "^[^\\u0000]*$" } }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "external.open" } } },
        "then": { "properties": { "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": { "url": { "type": "string", "minLength": 9, "maxLength": 2048 } }
        } } }
      }, {
        "if": { "properties": { "method": { "enum": ["file.openText", "folder.select", "clipboard.readText"] } } },
        "then": { "properties": { "params": { "type": "object", "maxProperties": 0 } } }
      }, {
        "if": { "properties": { "method": { "const": "file.beginSave" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["name", "bytes"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 240 },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 }
          }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "file.appendSave" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["token", "offset", "text"],
          "properties": {
            "token": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "offset": { "type": "integer", "minimum": 0, "maximum": 2097152 },
            "text": { "type": "string" }
          }
        } } }
      }, {
        "if": { "properties": { "method": { "enum": ["file.commitSave", "file.cancelSave", "file.commitSaveAs"] } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["token"],
          "properties": { "token": { "type": "integer", "minimum": 1, "maximum": 4294967295 } }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "file.commitSaveTo" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["token", "target"],
          "properties": {
            "token": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "target": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          }
        } } }
      }, {
        "if": { "properties": { "method": { "enum": ["file.releaseSaveTarget", "folder.release", "folder.list"] } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["target"],
          "properties": { "target": { "type": "integer", "minimum": 1, "maximum": 4294967295 } }
        } } }
      }, {
        "if": { "properties": { "method": { "const": "folder.openText" } } },
        "then": { "properties": { "params": {
          "type": "object", "additionalProperties": false, "required": ["target", "name"],
          "properties": {
            "target": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "name": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        } } }
      }]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "ok"],
      "properties": {
        "v": { "const": 1 },
        "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } } },
          "then": { "not": { "required": ["error"] } },
          "else": { "required": ["error"] }
        }
      ]
    }
  }
}
